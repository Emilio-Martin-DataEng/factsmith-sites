---
interface Props {
  onDark?: boolean;
  class?: string;
}

const { onDark = false, class: className = "" } = Astro.props;
const text = onDark ? "text-cream-50" : "text-ink-900";
const accent = onDark ? "text-sea-200" : "text-sea-600";
---

<a href="/" class={`inline-flex items-center gap-2 font-display ${className}`} aria-label="FactSmith Sites home">
  <span
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-sea-600 text-sm font-bold text-white"
    aria-hidden="true">FS</span
  >
  <span class={`text-base font-semibold tracking-tight ${text}`}>
    FactSmith <span class={accent}>Sites</span>
  </span>
</a>
