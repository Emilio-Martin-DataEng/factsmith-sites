---
interface Props {
  onDark?: boolean;
  class?: string;
}

const { onDark = false, class: className = "" } = Astro.props;
// The official lockup is navy on transparent, so on dark it sits on a cream chip.
const chip = onDark ? "rounded-lg bg-cream-50 px-2 py-1" : "";
---

<a href="/" class={`inline-flex items-center ${chip} ${className}`} aria-label="FactSmith Sites home">
  <img src="/brand/lockup.png" alt="FactSmith Sites" width="435" height="165" class="h-10 w-auto" />
</a>
