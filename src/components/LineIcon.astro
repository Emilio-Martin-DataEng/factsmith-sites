---
// Six line icons for the home page (problem block and How it works), redrawn by hand from the generated
// reference sheet (vault: "(C) Sites Icon and Mockup Prompt Pack 2026-10-28"). Lines take the text colour,
// one accent shape uses the hibiscus accent. 24 px grid, 1.75 stroke.
interface Props { name: "broken" | "nobutton" | "price" | "consult" | "preview" | "live"; class?: string }
const { name, class: cls = "h-10 w-10" } = Astro.props;
const phone = "M8.5 2.5h7a2.5 2.5 0 0 1 2.5 2.5v14a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 6 19V5a2.5 2.5 0 0 1 2.5-2.5zM10.5 5h3M10.5 19h3";
---
<svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "broken" && (
    <>
      <path d={phone} />
      <path d="M8.5 7.5h6M8.5 15.5h2.5" />
      <path d="M11.5 6.5l1.2 2.3-1.4 1.9 1.4 2.3-1 2.2" />
      <rect x="13.8" y="9.8" width="7" height="4.4" rx="0.6" class="fill-accent-600" stroke="none" />
    </>
  )}
  {name === "nobutton" && (
    <>
      <path d={phone} />
      <rect x="9.3" y="14.6" width="5.4" height="2.4" rx="1" class="stroke-accent-600" stroke-dasharray="1.4 1.1" />
      <path d="M19.6 8.6a1.6 1.6 0 1 1 1.8 1.6c-.5.1-.8.5-.8 1v.4" />
      <path d="M20.6 13.4v.01" />
    </>
  )}
  {name === "price" && (
    <>
      <path d="M3.8 13.2 11 6h6.3v6.3L10.1 19.5a1.4 1.4 0 0 1-2 0l-4.3-4.3a1.4 1.4 0 0 1 0-2z" />
      <path d="M15.7 7.6c.8-2.2 2.8-3.8 4.4-3.1 1.5.7.3 3.3-2.3 4.7" />
      <path d="M7.6 13.8l1.2-1.2 1 1.4 1.2-1.2 1 1.4" class="stroke-accent-300" />
      <circle cx="14.6" cy="8.7" r="1.3" class="fill-accent-600" stroke="none" />
    </>
  )}
  {name === "consult" && (
    <>
      <path d="M2.5 8C2.5 5.2 5 3.5 8 3.5s5.5 1.7 5.5 4.5S11 12.5 8 12.5c-.7 0-1.4-.1-2-.3L3.2 13.5l.8-2.2C3 10.4 2.5 9.3 2.5 8z" />
      <rect x="12.5" y="12" width="9" height="8.5" rx="1.5" />
      <path d="M12.5 14.8h9M15 10.8v2.4M19 10.8v2.4" />
      <rect x="14.3" y="16.4" width="2" height="2" class="fill-accent-600" stroke="none" />
      <rect x="17.6" y="16.4" width="2" height="2" class="fill-accent-600" stroke="none" />
    </>
  )}
  {name === "preview" && (
    <>
      <path d={phone} />
      <path d="M8.5 7h6M8.5 15h3M8.5 17h2" />
      <path d="M8.5 9h6v3.5h-6z" />
      <path d="M13.2 15.6c1.4-1.9 3-2.8 4.8-2.8s3.4.9 4.8 2.8c-1.4 1.9-3 2.8-4.8 2.8s-3.4-.9-4.8-2.8z" class="fill-white" />
      <circle cx="18" cy="15.6" r="1.3" class="fill-accent-600" stroke="none" />
    </>
  )}
  {name === "live" && (
    <>
      <path d={phone} />
      <path d="M12 14V3.2M8.9 6.3 12 3.2l3.1 3.1" class="stroke-accent-600" />
    </>
  )}
</svg>
