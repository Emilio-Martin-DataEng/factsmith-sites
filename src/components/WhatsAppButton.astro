---
import { site } from "../site.config";

interface Props {
  label?: string;
  variant?: "solid" | "outline" | "whatsapp";
  size?: "sm" | "md";
  class?: string;
}

const {
  label = "Chat on WhatsApp",
  variant = "whatsapp",
  size = "md",
  class: className = "",
} = Astro.props;

const href = `${site.whatsappLink}?text=${encodeURIComponent(site.whatsappMessage)}`;

const base =
  "inline-flex items-center gap-2 rounded-full font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sea-500 focus-visible:ring-offset-2";
const sizes = size === "sm" ? "px-4 py-2 text-sm" : "px-5 py-3 text-sm";
const styles =
  variant === "whatsapp"
    ? "bg-whatsapp text-white hover:bg-[#1ebe5b]"
    : variant === "outline"
      ? "border border-sea-300 text-sea-700 hover:bg-sea-50"
      : "bg-sea-600 text-white hover:bg-sea-700";
---

<a href={href} target="_blank" rel="noopener noreferrer" class={`${base} ${sizes} ${styles} ${className}`}>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.42a9.87 9.87 0 0 0 4.62 1.18h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.09c-.24.68-1.4 1.31-1.93 1.39-.5.08-1.12.11-1.8-.11-.42-.13-.95-.31-1.63-.6-2.87-1.24-4.74-4.14-4.88-4.33-.14-.19-1.17-1.56-1.17-2.98s.75-2.11 1.02-2.4c.27-.29.58-.36.78-.36h.55c.18 0 .41-.03.64.49.24.55.8 1.9.87 2.04.07.14.12.3.02.49-.1.19-.15.31-.29.48-.14.17-.3.37-.43.5-.14.14-.29.29-.13.57.17.29.75 1.24 1.61 2.01 1.11.99 2.05 1.3 2.33 1.44.28.14.45.12.61-.07.17-.19.7-.82.89-1.1.19-.28.38-.24.63-.14.26.1 1.63.77 1.91.91.28.14.47.21.54.33.07.12.07.68-.16 1.36Z"
    ></path>
  </svg>
  {label}
</a>
