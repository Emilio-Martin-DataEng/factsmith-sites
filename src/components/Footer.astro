---
import { nav, site } from "../site.config";
import BrandMark from "./BrandMark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-sea-800 bg-sea-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <BrandMark onDark />
        <p class="mt-4 text-sm leading-relaxed text-sea-100">
          FactSmith Sites builds websites for South Coast businesses. FactSmith the product is
          local-network business intelligence —
          <a href={site.productUrl} class="underline decoration-sea-400 underline-offset-2 hover:text-white"
            >www.factsmith.co.za</a
          >.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-sea-200">Navigate</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/" class="text-sea-100 hover:text-white">Home</a>
          </li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sea-100 hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-sea-200">Get in touch</h2>
        <ul class="mt-3 space-y-2 text-sm text-sea-100">
          <li>
            <a href={site.whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-white">
              WhatsApp: {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
          </li>
        </ul>
        <p class="mt-4 text-xs text-sea-300">Invoices: {site.billingEntity}</p>
      </div>
    </div>

    <p class="mt-10 border-t border-sea-700 pt-6 text-xs text-sea-200">
      &copy; {year} {site.name}. Built on the KZN South Coast.
    </p>
  </div>
</footer>
