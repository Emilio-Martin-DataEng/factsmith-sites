---
import { nav, site } from "../site.config";
import BrandMark from "./BrandMark.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-sea-100 bg-cream-50/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <BrandMark />

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {
        nav.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                "border-b-2 pb-0.5 text-sm font-medium transition-colors hover:text-sea-600",
                isActive ? "border-sea-600 text-sea-700" : "border-transparent text-ink-700",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <WhatsAppButton label="WhatsApp" size="sm" class="hidden sm:inline-flex" />
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-sea-700 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-current">
          <path d="M4 6h16v2H4zM4 11h16v2H4zM4 16h16v2H4z"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden flex-col gap-1 border-t border-sea-100 bg-cream-50 px-4 py-3 md:hidden"
    aria-label="Mobile"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-2 py-2 text-sm font-medium text-ink-700 hover:bg-sea-50 hover:text-sea-700"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={`${site.whatsappLink}?text=${encodeURIComponent(site.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 rounded-full bg-whatsapp px-3 py-2 text-center text-sm font-semibold text-white"
    >
      Chat on WhatsApp
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
