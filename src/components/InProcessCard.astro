---
interface Image {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  kind: string;
  package: string;
  blurb: string;
  hero: string;
  heroAlt: string;
  images: readonly Image[];
  currentUrl?: string;
}

const { title, kind, package: pkg, blurb, hero, heroAlt, images, currentUrl } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-sea-100 bg-white shadow-sm">
  <div class="relative aspect-[16/9] bg-sea-100">
    <img src={hero} alt={heroAlt} class="h-full w-full object-cover" loading="lazy" />
    <span
      class="absolute left-3 top-3 rounded-full bg-cream-50/95 px-3 py-1 text-xs font-semibold text-sea-800"
    >
      {pkg}
    </span>
  </div>
  <div class="p-5 sm:p-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{kind}</p>
    <h3 class="mt-1 font-display text-xl font-semibold text-ink-900">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-700">{blurb}</p>
    {
      currentUrl ? (
        <a
          href={currentUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-semibold text-sea-700 hover:text-sea-500"
        >
          Current site →
        </a>
      ) : null
    }
    {
      images.length > 0 ? (
        <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {images.map((img) => (
            <a href={img.src} class="block overflow-hidden rounded-lg bg-sea-50">
              <img
                src={img.src}
                alt={img.alt}
                class="aspect-[4/3] h-full w-full object-cover object-top"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      ) : null
    }
  </div>
</article>
