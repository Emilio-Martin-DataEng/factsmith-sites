---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { adminFeatures, libraryPages, site, standardFeatures, zar } from "../site.config";

const kindLabel = { template: "Free library page, every tier", researched: "Free library page, Brochure and up", app: "Phone app: included Brochure and up, R1 500 on Starter" };
---

<BaseLayout
  title="Included"
  description="Standard on every FactSmith site: map and directions, fly-to, SEO, GEO and AEO, a Facebook or Instagram window, WhatsApp, tap-to-call, and Search Console, Bing and Analytics in your name. Plus a page library, free where it fits: weather and tides, researched attractions and restaurants pages."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-ink-900">Included on every site</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Built in from the first build on every tier. Further down, the phone app and the admin dashboard are extras on some tiers, and each one says where it is included.
    </p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        standardFeatures.map((feature) => (
          <li class="rounded-2xl border border-sea-100 bg-white p-5 shadow-sm sm:p-6">
            <h2 class="font-display text-lg font-semibold text-ink-900">{feature.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-ink-700 sm:text-base">{feature.text}</p>
            {"example" in feature ? (
              <a
                href={feature.example.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex text-sm font-semibold text-accent-600 hover:text-accent-700"
              >
                See it: {feature.example.label} →
              </a>
            ) : null}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-sea-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-semibold text-ink-900">The page library: free where it fits</h2>
      <p class="mt-3 max-w-2xl text-ink-700">
        A guest house gets weather and tides; a fencing firm does not. We add the library pages your
        customers will use, <strong class="text-accent-700">at no page-building charge</strong>. Starter
        gets the template pages; Brochure and up also get the researched ones. Pictures are from Eagle’s Roost in Umtentweni.
      </p>

      <div class="mt-12 space-y-14">
        {
          libraryPages.map((feature, i) => (
            <article class={`grid items-center gap-8 md:grid-cols-2 ${i % 2 ? "md:[&>figure]:order-first" : ""}`}>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{kindLabel[feature.kind]}</p>
                <h3 class="mt-1 font-display text-2xl font-semibold text-ink-900">{feature.title}</h3>
                <p class="mt-3 leading-relaxed text-ink-700">{feature.text}</p>
                <p class="mt-4 text-sm font-semibold">
                  <a href={feature.example.href} target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700">
                    See it: {feature.example.label} →
                  </a>
                  {"extra" in feature ? (
                    <a href={feature.extra.href} target="_blank" rel="noopener noreferrer" class="ml-3 text-accent-600 hover:text-accent-700">
                      {feature.extra.label} →
                    </a>
                  ) : null}
                </p>
              </div>
              <figure class={feature.phone ? "flex justify-center" : ""}>
                <img
                  src={feature.image}
                  alt={feature.imageAlt}
                  loading="lazy"
                  class={
                    feature.phone
                      ? "w-64 rounded-[2rem] border-8 border-ink-900 shadow-lg"
                      : "w-full rounded-2xl border border-sea-100 shadow-lg"
                  }
                />
              </figure>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 id="dashboard" class="scroll-mt-24 font-display text-3xl font-semibold text-ink-900">The admin dashboard</h2>
        <p class="mt-3 text-ink-700">
          One private page for your site's numbers, progress and to-dos, with the links you would
          otherwise hunt for, so you do not log in to several tools to see whether the site is bringing people in.
        </p>
        <p class="mt-3 text-sm font-semibold text-sea-800">
          Included on Business and Custom. On Starter and Brochure it is a one-off {zar(site.adminAddonPriceZar)} set-up add-on, without ongoing upkeep. Ask for it
          with your quote, or add it to a site we have already built.
        </p>
      </div>
      <ul class="space-y-3">
        {
          adminFeatures.map((item) => (
            <li class="flex gap-3 rounded-xl border border-sea-100 bg-white p-4 text-sm leading-relaxed text-ink-700">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 grid gap-8">
      <figure>
        <img
          src="/images/dashboard/project-completion.webp"
          alt="The project completion board on the Eagle's Roost dashboard: four lanes of steps from Plan to Measure, each box marked Done, To do or Unknown"
          width="1180"
          height="428"
          loading="lazy"
          class="w-full rounded-2xl border border-sea-100 shadow-lg"
        />
        <figcaption class="mt-2 text-sm text-ink-500">Project completion: each box ticks itself from automatic checks of the live site. Example from Eagle’s Roost.</figcaption>
      </figure>
      <figure>
        <img
          src="/images/dashboard/reminders-links.webp"
          alt="Task reminders and a links panel on the Eagle's Roost dashboard: reminders with dates and owners, and links to the live site, Google Analytics, Search Console and the social pages"
          width="1180"
          height="400"
          loading="lazy"
          class="w-full rounded-2xl border border-sea-100 shadow-lg"
        />
        <figcaption class="mt-2 text-sm text-ink-500">Task reminders and the accounts behind the site, in one place. Visits and Google searches load once you sign in with Google.</figcaption>
      </figure>
    </div>

    <div class="mt-14 flex flex-wrap items-center gap-4">
      <WhatsAppButton label="Start with a WhatsApp" />
      <a href="/technical/" class="text-sm font-semibold text-sea-700 hover:text-accent-600">How it is built: stack, SEO, AEO, GEO →</a>
      <a href="/work/" class="text-sm font-semibold text-sea-700 hover:text-accent-600">See the work →</a>
    </div>
  </section>
</BaseLayout>
