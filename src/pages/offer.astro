---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site, launchOffer } from "../site.config";

const included = [
  "4–6 page static brochure (Home, About, Services/Rooms, Contact)",
  "Mobile-first custom design from an agreed homepage sample",
  "Two focused revision rounds after the first private preview",
  "Contact form + WhatsApp as the primary button",
  "Hosting setup on the path you choose (keep current or free static)",
  "Email path as agreed (keep yours or free forwarding)",
  "Technical SEO foundations and clear factual structure",
  "Hand-over of all source files",
];

const notIncluded = [
  "New domain — only if you need one, at actual registrar cost",
  "Ongoing hosting or domain renewal bills",
  "Search Console + Bing ownership — R1 000 add-on (free on the launch five)",
  "Extra top-level pages beyond six — quoted separately",
  "Photography, logo design, or writing from scratch",
  "Booking engines, payments, shops, or memberships",
  "WordPress or a CMS so a cousin can edit pages",
  "Monthly retainers, blogs, or link-building",
];
---

<BaseLayout
  title="Offer"
  description="South Coast website rebuild — R7 500, or R4 000 for the first five sites. Mockups this weekend, live next week."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">Published package</p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-ink-900">South Coast website rebuild</h1>
    {
      launchOffer.active ? (
        <p class="mt-4 flex flex-wrap items-baseline gap-3">
          <span class="text-2xl font-medium text-ink-500 line-through decoration-2">
            R{site.standardPriceZar.toLocaleString("en-ZA")}
          </span>
          <span class="font-display text-4xl font-semibold text-sea-700">
            R{site.priceZar.toLocaleString("en-ZA")}
          </span>
          <span class="text-sm font-semibold uppercase tracking-wide text-sea-600">
            first {launchOffer.slots} sites
          </span>
        </p>
      ) : (
        <p class="mt-4 font-display text-4xl font-semibold text-sea-700">
          R{site.standardPriceZar.toLocaleString("en-ZA")}
        </p>
      )
    }

    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Fixed price for the site. Deposit R{site.depositZar.toLocaleString("en-ZA")} to start —
      balance within 7 days of hand-over.
    </p>

    {
      launchOffer.active ? (
        <div class="mt-6 max-w-3xl rounded-2xl border-2 border-sea-600 bg-sea-50 px-5 py-5">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-sea-600 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
              {launchOffer.headline}
            </span>
            <span class="font-display text-base font-semibold text-sea-900">{launchOffer.lede}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-sea-800">{launchOffer.detail}</p>
          <ul class="mt-3 space-y-1.5 text-sm text-sea-800">
            <li class="flex gap-2">
              <span class="text-sea-600" aria-hidden="true">✓</span>
              <span>{launchOffer.bonus}</span>
            </li>
            <li class="flex gap-2">
              <span class="text-sea-600" aria-hidden="true">✓</span>
              <span><strong>{launchOffer.turnaround}</strong></span>
            </li>
          </ul>
        </div>
      ) : null
    }

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
        <h2 class="font-display text-base font-semibold text-ink-900">Already have a domain?</h2>
        <p class="mt-2 text-sm text-ink-700">
          We use it. <strong>No registration fee.</strong> Need a new `.co.za`? Registered in your
          name at actual cost (typically R90–R150) — not inside the site fee.
        </p>
      </div>
      <div class="rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
        <h2 class="font-display text-base font-semibold text-ink-900">Already pay for hosting?</h2>
        <p class="mt-2 text-sm text-ink-700">
          Your call: <strong>keep</strong> what you have if it can serve the new site, or
          <strong> downscale</strong> to free static hosting and stop paying monthly fees you no
          longer need.
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="rounded-2xl border border-sea-100 bg-white p-6 shadow-sm">
        <h2 class="font-display text-xl font-semibold text-ink-900">Included</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          {included.map((item) => <li class="flex gap-2"><span class="text-sea-600" aria-hidden="true">✓</span><span>{item}</span></li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-sea-100 bg-cream-100 p-6">
        <h2 class="font-display text-xl font-semibold text-ink-900">Not in this fee</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          {notIncluded.map((item) => <li class="flex gap-2"><span class="text-ink-500" aria-hidden="true">–</span><span>{item}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-10 rounded-2xl bg-sea-900 p-6 text-cream-50 sm:p-8">
      <h2 class="font-display text-xl font-semibold">Late content does not pause us</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-sea-100">
        Send what you can. If something is still missing when we need it, we finish with
        AI-suggested copy from your ads and the agreed sample. You can still swap words in any
        remaining revision round.
      </p>
      <p class="mt-4 text-xs text-sea-300">Invoices from {site.billingEntity}.</p>
      <div class="mt-6">
        <WhatsAppButton label="Ask about your site" />
      </div>
    </div>
  </section>
</BaseLayout>
