---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { faq, growthCare, logoService, site, tiers, wpCare, zar } from "../site.config";

const everyTier = [
  "Mobile-first custom design from an agreed homepage sample",
  "Two focused revision rounds after the first private preview",
  "WhatsApp as the primary button, plus a contact form once it is connected and tested",
  "Map, fly-to, SEO, GEO and AEO, and a Facebook or Instagram window, built in, see Included",
  "Google Search Console and Bing set up in your name, and Google Analytics",
  "Hosting setup on the path you choose (keep current or free static)",
  "Email path as agreed (keep yours or free forwarding)",
  "A full copy of your site files at hand-over, with no lock-in and no exit fee",
  "Library pages where they fit your business, see Included",
];

const quoted = [
  "New domain, only if you need one, at actual registrar cost",
  "Ongoing hosting or domain renewal bills",
  "More custom pages than your tier allows",
  "Photography, or writing from scratch",
  "Online shops, WooCommerce, booking engines, payments or memberships (the Custom tier)",
  "A WordPress site, or a CMS so you can edit pages yourself (the Custom tier, quoted)",
  "Blogs, link-building, or retainers other than the two care plans",
  "Customisation of the phone app beyond your website's own content",
  "Third-party and API costs",
];

---

<BaseLayout
  title="Offer"
  description={`Website tiers from ${zar(site.startingPriceZar)}: Starter, Brochure, Business and Custom. Fixed prices in rand, outside South Africa by quote.`}
  faq={faq}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">Published tiers</p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-ink-900">A website for your business</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Fixed prices in rand. Deposit {zar(site.depositZar)} to start a Starter or Brochure job, balance
      within 7 days of hand-over. Outside South Africa? Ask for a quote.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        tiers.map((tier) => (
          <div class="flex flex-col rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
            <h2 class="font-display text-lg font-semibold text-ink-900">{tier.name}</h2>
            <p class="mt-2 font-display text-3xl font-semibold text-sea-700">{tier.priceLabel}</p>
            <p class="mt-3 text-sm font-semibold text-ink-900">{tier.pages}</p>
            <p class="mt-2 text-sm text-ink-700">{tier.library}</p>
            <p class="mt-2 text-sm font-semibold text-sea-800">{tier.app}</p>
            <p class="mt-1 text-sm font-semibold text-sea-800">{tier.admin}</p>
            <p class="mt-3 text-sm text-ink-500">{tier.forWho}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
        <h2 class="font-display text-base font-semibold text-ink-900">Already have a domain?</h2>
        <p class="mt-2 text-sm text-ink-700">
          We use it. <strong>No registration fee.</strong> Need a new `.co.za`? Registered in your
          name at actual cost (typically R90 to R150), not inside the site fee.
        </p>
      </div>
      <div class="rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
        <h2 class="font-display text-base font-semibold text-ink-900">Already pay for hosting?</h2>
        <p class="mt-2 text-sm text-ink-700">
          Your call: <strong>keep</strong> what you have if it can serve the new site, or
          <strong> downscale</strong> to free static hosting and stop paying monthly fees you no
          longer need.
        </p>
      </div>
    </div>

    <div id="logo" class="mt-8 scroll-mt-24 rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
      <h2 class="font-display text-base font-semibold text-ink-900">{logoService.name}</h2>
      <p class="mt-2 text-sm text-ink-700">{logoService.lede} <strong>{logoService.pricing}</strong></p>
    </div>

    <div class="mt-4 rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
      <h2 class="font-display text-base font-semibold text-ink-900">{wpCare.name}: {wpCare.priceLabel}</h2>
      <p class="mt-2 text-sm text-ink-700">{wpCare.text}</p>
    </div>

    <div class="mt-4 rounded-2xl border border-sea-200 bg-white p-5 shadow-sm">
      <h2 class="font-display text-base font-semibold text-ink-900">{growthCare.name}: {growthCare.priceLabel}</h2>
      <p class="mt-2 text-sm text-ink-700">{growthCare.text}</p>
      <p class="mt-3 text-sm font-semibold text-ink-900">Every month</p>
      <ul class="mt-2 space-y-2 text-sm text-ink-700">
        {growthCare.monthly.map((item) => <li class="flex gap-2"><span class="text-sea-600" aria-hidden="true">✓</span><span>{item}</span></li>)}
      </ul>
      <p class="mt-3 text-xs text-ink-500">{growthCare.limit}</p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="rounded-2xl border border-sea-100 bg-white p-6 shadow-sm">
        <h2 class="font-display text-xl font-semibold text-ink-900">On every tier</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          {everyTier.map((item) => <li class="flex gap-2"><span class="text-sea-600" aria-hidden="true">✓</span><span>{item}</span></li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-sea-100 bg-cream-100 p-6">
        <h2 class="font-display text-xl font-semibold text-ink-900">Quoted separately</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-700">
          {quoted.map((item) => <li class="flex gap-2"><span class="text-ink-500" aria-hidden="true">-</span><span>{item}</span></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-2xl font-semibold text-ink-900">Common questions</h2>
      <dl class="mt-5 grid gap-4 md:grid-cols-2">
        {
          faq.map(({ q, a }) => (
            <div class="rounded-2xl border border-sea-100 bg-white p-5">
              <dt class="font-display font-semibold text-ink-900">{q}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-ink-700">{a}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-10 rounded-2xl bg-sea-900 p-6 text-cream-50 sm:p-8">
      <h2 class="font-display text-xl font-semibold">Late content does not pause us</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-sea-100">
        Send what you can. If something is still missing when we need it, we finish with
        AI-suggested copy from your ads and the agreed sample. You can still swap words in any
        remaining revision round.
      </p>
      <p class="mt-4 text-xs text-sea-300">Invoices from {site.billingEntity}.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <BookButton />
        <WhatsAppButton variant="outline" label="South Coast: message Sharon" />
        <WhatsAppButton
          variant="outline"
          label="Elsewhere: message Emilio"
          href={site.emilio.whatsappLink}
          message={site.emilio.whatsappMessage}
        />
      </div>
    </div>
  </section>
</BaseLayout>
