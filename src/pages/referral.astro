---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site, referral, zar } from "../site.config";

const introMessage = "Hi Emilio, I would like to introduce someone to FactSmith Sites for the referral reward.";
const groupTemplate = `Hey [Client Name] and Emilio, making a quick intro here!

[Client Name], this is Emilio from FactSmith Sites. He builds fast, clean websites that work properly on phones and bring in real enquiries.

Emilio, [Client Name] runs [Business Name] and is looking to get a proper website set up or rebuilt.

I'll let you two take it from here.`;
---

<BaseLayout
  title="Earn with a referral"
  description={`Earn cash for a warm introduction to a business that needs a website: ${referral.rewards.map((r) => `${zar(r.total)} for ${r.tier}`).join(", ")}, plus ${referral.addonPercent}% on add-ons.`}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Introduction rewards</p>
    <h1 class="mt-1 font-display text-4xl font-semibold text-ink-900">Earn cash for a warm introduction</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Know a business owner whose website is overdue, or who has none? Introduce us. If the deal closes, we share
      the reward with you, paid across the project.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        referral.rewards.map((r) => (
          <div class="rounded-2xl border border-accent-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-sea-800">{r.tier} referral</p>
            <p class="mt-1 font-display text-3xl font-semibold text-ink-900">{zar(r.total)}</p>
            <p class="mt-2 text-sm text-ink-700">
              {zar(r.total / 2)} when the deposit clears, {zar(r.total / 2)} when the site is complete and the final invoice is paid.
            </p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 max-w-2xl text-ink-700">
      Plus {referral.addonPercent}% on any additional services your contact orders, such as a logo or a Growth care
      plan, paid when that invoice clears. {referral.note}
    </p>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">How it works</h2>
    <ol class="mt-4 max-w-2xl list-decimal space-y-2 pl-5 text-ink-700">
      <li>Tell your contact about us and check they are happy to be introduced.</li>
      <li>Introduce them to Emilio in a 3-way WhatsApp group, or by email to {site.email}. This is how we log your referral.</li>
      <li>They agree a package and pay the deposit. Your first half is paid when it clears.</li>
      <li>The site goes live and the final invoice is paid. Your second half follows within {referral.payDays} days.</li>
    </ol>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">What counts as a warm introduction</h2>
    <ul class="mt-4 max-w-2xl list-disc space-y-2 pl-5 text-ink-700">
      <li>A direct introduction to a business owner who has agreed to hear from us.</li>
      <li>The business is new to us, not an existing client or an open enquiry.</li>
      <li>Cold lists, or a link sent to a stranger or posted publicly, do not qualify.</li>
      <li>No reward is paid on a deposit that is refunded or a job that does not go ahead.</li>
    </ul>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">Copy and paste intro</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-500">Create a WhatsApp group with Emilio and your contact, then paste:</p>
    <pre class="mt-3 max-w-2xl whitespace-pre-wrap rounded-2xl border border-sea-200 bg-sea-50 p-5 text-sm leading-relaxed text-ink-800">{groupTemplate}</pre>

    <div class="mt-10">
      <WhatsAppButton label="Introduce a business" href={site.emilio.whatsappLink} message={introMessage} />
    </div>
  </section>
</BaseLayout>
