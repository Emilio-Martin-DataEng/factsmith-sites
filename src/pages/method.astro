---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { methodSteps } from "../site.config";
---

<BaseLayout
  title="Method"
  description="How a FactSmith Sites job runs — the Three Birds process, plain language."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-ink-900">How we work</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Same sequence we used for Three Birds Online Learning Centre. You own the domain. Hosting
      starts at R0. Two focused revision rounds are in the fee.
    </p>

    <ol class="mt-12 space-y-6">
      {
        methodSteps.map((step, index) => (
          <li class="flex gap-4 rounded-2xl border border-sea-100 bg-white p-5 shadow-sm sm:gap-6 sm:p-6">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sea-600 font-display text-sm font-semibold text-white"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div>
              <h2 class="font-display text-lg font-semibold text-ink-900">{step.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-ink-700 sm:text-base">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 flex flex-wrap items-center gap-4">
      <WhatsAppButton label="Start with a WhatsApp" />
      <a href="/offer" class="text-sm font-semibold text-sea-700 hover:text-sea-500">
        Full offer details →
      </a>
    </div>
  </section>
</BaseLayout>
