---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { inProcess, samples, site, launchOffer } from "../site.config";
---

<BaseLayout title={site.name}>
  <section class="relative overflow-hidden bg-gradient-to-b from-cream-50 to-sea-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">KZN South Coast</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">
        Your website is costing you enquiries.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-700">
        FactSmith Sites rebuilds broken brochure sites for small and medium businesses on the Hibiscus
        Coast — mobile-first, WhatsApp-first, domain in your name, hosting at R0.
      </p>

      {
        launchOffer.active ? (
          <div class="mt-7 max-w-2xl rounded-2xl border-2 border-sea-600 bg-white/80 p-5 shadow-sm backdrop-blur">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-sea-600 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                {launchOffer.headline}
              </span>
              <p class="flex items-baseline gap-2">
                <span class="text-lg font-medium text-ink-500 line-through decoration-2">
                  R{site.standardPriceZar.toLocaleString("en-ZA")}
                </span>
                <span class="font-display text-3xl font-semibold text-sea-700">
                  R{site.priceZar.toLocaleString("en-ZA")}
                </span>
              </p>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">
              A R{site.depositZar.toLocaleString("en-ZA")} deposit secures one of the five slots and
              locks the price. After that the published price is
              R{site.standardPriceZar.toLocaleString("en-ZA")}.
            </p>
            <p class="mt-2 text-sm font-semibold text-sea-800">{launchOffer.turnaround}</p>
          </div>
        ) : (
          <p class="mt-5 max-w-2xl text-lg text-ink-700">
            Fixed price <strong>R{site.standardPriceZar.toLocaleString("en-ZA")}</strong>.
          </p>
        )
      }

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <WhatsAppButton label="Chat about a rebuild" />
        <a href="/offer" class="text-sm font-semibold text-sea-700 hover:text-sea-500">
          See what’s included →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">Live</h2>
      <a href="/work" class="text-sm font-semibold text-sea-700 hover:text-sea-500">All work →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        samples.map((sample) => (
          <article class="rounded-2xl border border-sea-100 bg-white p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{sample.kind}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{sample.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">{sample.blurb}</p>
            {sample.url ? (
              <a
                href={sample.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:text-sea-500"
              >
                Visit live site →
              </a>
            ) : null}
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">In process</h2>
      <a href="/work#in-process" class="text-sm font-semibold text-sea-700 hover:text-sea-500">
        Mockups and photos →
      </a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        inProcess.map((job) => (
          <a href="/work#in-process" class="group overflow-hidden rounded-2xl border border-sea-100 bg-white shadow-sm">
            <div class="aspect-[16/10] overflow-hidden bg-sea-100">
              <img
                src={job.hero}
                alt={job.heroAlt}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{job.kind}</p>
              <h3 class="mt-1 font-display text-lg font-semibold text-ink-900">{job.title}</h3>
              <p class="mt-2 text-xs font-medium text-sea-700">{job.package}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-sea-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-3">
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">Fixed price, no surprises</h2>
        <p class="mt-2 text-sm text-ink-700">
          Four to six pages, two revision rounds, deposit half up front. Domain at actual cost.
          R{site.standardPriceZar.toLocaleString("en-ZA")} — or
          R{site.priceZar.toLocaleString("en-ZA")} while the launch five last.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">You own it</h2>
        <p class="mt-2 text-sm text-ink-700">
          Keep your domain if you have one. Keep or downscale hosting. Source files handed over.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">Local process</h2>
        <p class="mt-2 text-sm text-ink-700">
          Same method we used for Three Birds in Anerley — Sharon handles the client side after you
          say yes.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-display text-2xl font-semibold text-ink-900">Ready for a straight conversation?</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-700">
      Send the link to your current site. We’ll tell you honestly whether a rebuild is worth it.
    </p>
    <div class="mt-6 flex justify-center">
      <WhatsAppButton />
    </div>
  </section>
</BaseLayout>
