---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { inProcess, samples, site, launchOffer } from "../site.config";

// Layout 3 "Free check first" (Sharon, Round 1), with her Round 2 picks: headline B, price with the
// standard price crossed out, and the free-check steps as the first block under the hero.
const price = (launchOffer.active ? site.priceZar : site.standardPriceZar).toLocaleString("en-ZA");
const standardPrice = site.standardPriceZar.toLocaleString("en-ZA");
const checkMessage = "Hi Sharon, please check my website: ";
const steps = [
  "Send us the link to your current site on WhatsApp.",
  `${site.contactName.split(" ")[0]} tells you honestly whether a rebuild is worth it, and why.`,
  `If it is: R${price} fixed, R${site.depositZar.toLocaleString("en-ZA")} deposit to start.`,
];
---

<BaseLayout title={site.name}>
  <section class="bg-cream-50">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">KZN South Coast · Hibiscus Coast</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">
        Your website should bring you enquiries, not lose them.
      </h1>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-lg text-ink-700">
        <span class="rounded-full bg-accent-600 px-4 py-1.5 font-display text-xl font-semibold text-white">
          {launchOffer.active ? <s class="mr-2 text-base font-medium text-white/80 decoration-2">R{standardPrice}</s> : null}R{price}
        </span>
        <span>fixed price, and you own everything.</span>
      </p>
      <p class="mt-5 max-w-xl text-ink-700">
        Websites that work on a phone, with WhatsApp as the main button, for small businesses on the South Coast. Domain in
        your name, source files handed over.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 class="font-display text-3xl font-semibold text-ink-900">Start with a free website check</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          steps.map((text, i) => (
            <li class="rounded-2xl border-t-4 border-accent-600 bg-cream-50 p-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-sea-700 font-display text-xl font-bold text-white">{i + 1}</span>
              <p class="mt-4 text-lg leading-snug text-ink-900">{text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <WhatsAppButton label="Get my free check" message={checkMessage} />
        <span class="text-sm text-ink-500">No site yet? Say so, we start from scratch.</span>
      </div>
    </div>
  </section>

  <section class="border-y border-sea-100 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      {
        launchOffer.active ? (
          <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div>
              <span class="rounded-full bg-accent-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent-700">
                {launchOffer.headline}
              </span>
              <p class="mt-3 flex items-baseline gap-3">
                <span class="font-display text-4xl font-semibold text-accent-600">R{site.priceZar.toLocaleString("en-ZA")}</span>
                <span class="text-lg font-medium text-ink-500 line-through decoration-2">
                  R{site.standardPriceZar.toLocaleString("en-ZA")}
                </span>
              </p>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-700">
                A R{site.depositZar.toLocaleString("en-ZA")} deposit secures one of the five slots and
                locks the price. After that the published price is
                R{site.standardPriceZar.toLocaleString("en-ZA")}. {launchOffer.turnaround}
              </p>
            </div>
            <a href="/offer/" class="shrink-0 text-sm font-semibold text-sea-700 hover:text-accent-600">
              See what’s included →
            </a>
          </div>
        ) : (
          <a href="/offer/" class="text-sm font-semibold text-sea-700 hover:text-accent-600">See what’s included →</a>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">Live</h2>
      <a href="/work/" class="text-sm font-semibold text-sea-700 hover:text-sea-500">All work →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        samples.map((sample) => (
          <article class="overflow-hidden rounded-2xl border border-sea-100 bg-white p-6 shadow-sm">
            {"hero" in sample ? (
              <img src={sample.hero} alt={sample.heroAlt} class="-mx-6 -mt-6 mb-5 aspect-[16/8] w-[calc(100%+3rem)] max-w-none object-cover" loading="lazy" />
            ) : null}
            <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{sample.kind}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{sample.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">{sample.blurb}</p>
            {sample.url ? (
              <a
                href={sample.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex text-sm font-semibold text-accent-600 hover:text-accent-700"
              >
                Visit live site →
              </a>
            ) : null}
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">In process</h2>
      <a href="/work/#in-process" class="text-sm font-semibold text-sea-700 hover:text-sea-500">
        Mockups and photos →
      </a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        inProcess.map((job) => {
          const previewUrl = "previewUrl" in job ? job.previewUrl : undefined;
          const href = previewUrl ?? "/work/#in-process";
          const external = Boolean(previewUrl);
          return (
            <a
              href={href}
              class="group overflow-hidden rounded-2xl border border-sea-100 bg-white shadow-sm"
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              <div class="aspect-[16/10] overflow-hidden bg-sea-100">
                <img
                  src={job.hero}
                  alt={job.heroAlt}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{job.kind}</p>
                <h3 class="mt-1 font-display text-lg font-semibold text-ink-900">{job.title}</h3>
                <p class="mt-2 text-xs font-medium text-sea-700">{job.package}</p>
                {
                  previewUrl ? (
                    <p class="mt-3 text-sm font-semibold text-sea-700 group-hover:text-sea-500">
                      Open work-in-progress preview →
                    </p>
                  ) : null
                }
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="border-y border-sea-100 bg-cream-100">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-3">
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">Fixed price, no surprises</h2>
        <p class="mt-2 text-sm text-ink-700">
          Four to six pages, two revision rounds, deposit half up front. Domain at actual cost.
          R{site.standardPriceZar.toLocaleString("en-ZA")}, or
          R{site.priceZar.toLocaleString("en-ZA")} while the launch five last.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">You own it</h2>
        <p class="mt-2 text-sm text-ink-700">
          Keep your domain if you have one. Keep or downscale hosting. Source files handed over.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">Local process</h2>
        <p class="mt-2 text-sm text-ink-700">
          Same method we used for Three Birds in Anerley, Sharon handles the client side after you
          say yes.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-display text-2xl font-semibold text-ink-900">Ready for a straight conversation?</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-700">
      Send the link to your current site. We’ll tell you honestly whether a rebuild is worth it.
    </p>
    <div class="mt-6 flex justify-center">
      <WhatsAppButton label="Get my free check" message={checkMessage} />
    </div>
  </section>
</BaseLayout>
