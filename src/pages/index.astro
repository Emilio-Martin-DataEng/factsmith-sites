---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookButton from "../components/BookButton.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import LineIcon from "../components/LineIcon.astro";
import { faq, inProcess, logoService, methodSteps, phoneApp, samples, site, tiers, zar } from "../site.config";

// Four of the common questions, in the order they are asked: cost, enquiries, ownership, domain.
const homeFaq = [faq[0], faq[4], faq[5], faq[6]];

const stepIcons = ["consult", "preview", "live"] as const;

const homeSteps = [
  methodSteps[1],
  {
    title: "We build, you preview",
    text: "We build from an agreed sample and you review a private preview. Two focused revision rounds are in the fee.",
  },
  methodSteps[7],
];
---

<BaseLayout title={site.name} faq={homeFaq}>
  <section class="bg-cream-50">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-5 lg:items-start">
      <div class="lg:col-span-3">
      <p class="hero-rise text-sm font-semibold uppercase tracking-wide text-sea-600" style="--d:0s">Websites for small businesses</p>
      <h1 class="hero-rise mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl">
        Your website should bring you enquiries, not lose them.
      </h1>
      <p class="hero-rise mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-lg text-ink-700" style="--d:0.2s">
        <span class="rounded-full bg-accent-600 px-4 py-1.5 font-display text-xl font-semibold text-white">
          from {zar(site.startingPriceZar)}
        </span>
        <span>fixed price, and you own everything.</span>
      </p>
      <p class="hero-rise mt-5 max-w-xl text-ink-700" style="--d:0.3s">
        Websites that work on a phone, with WhatsApp as the main button, for small businesses across South Africa. Domain in
        your name, source files handed over. Outside South Africa? Ask for a quote.
      </p>
      <div class="hero-rise hero-buttons mt-6 flex flex-wrap gap-3" style="--d:0.4s">
        <BookButton />
        <WhatsAppButton variant="outline" label="Chat on WhatsApp" />
      </div>
      </div>
      <div class="hero-rise rounded-3xl border border-sea-200 bg-white p-5 shadow-sm sm:p-6 lg:col-span-2" style="--d:0.25s">
        <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">Choose your starting point</p>
        <ul class="mt-4 divide-y divide-sea-100">
          {
            tiers.map((tier, i) => (
              <li class="hero-rise py-3 first:pt-0 last:pb-0" style={`--d:${0.5 + i * 0.1}s`}>
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-display text-base font-semibold text-ink-900">{tier.name}</p>
                  <p class="font-display text-lg font-semibold text-accent-600">{tier.priceLabel}</p>
                </div>
                <p class="text-sm text-ink-700">{tier.pages}</p>
                <p class="mt-1 text-xs text-ink-500">{tier.forWho}</p>
              </li>
            ))
          }
        </ul>
        <a href="/offer/" class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:text-accent-600">See what’s included →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <div class="grid overflow-hidden rounded-3xl border border-sea-100 shadow-sm md:grid-cols-5">
      <div class="flex flex-col justify-between gap-8 bg-sea-900 p-6 text-cream-50 sm:p-8 md:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-sea-200">The short answer</p>
        <h2 class="font-display text-2xl font-semibold">What does FactSmith Sites do?</h2>
      </div>
      <div class="bg-white p-6 sm:p-8 md:col-span-3">
        <p class="font-display text-lg font-semibold text-ink-900">
          We build fast, plain websites for small South African businesses, from <span class="whitespace-nowrap">{zar(site.startingPriceZar)}</span>, at a fixed price.
        </p>
        <p class="mt-3 text-ink-700">
          Every site works on a phone, has WhatsApp as the main button, and sits on your own domain with the source files handed
          over to you. Sharon looks after the South Coast and Emilio looks after everyone else.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            ["Fixed price", "WhatsApp first", "You own the domain", "Two revision rounds"].map((pill) => (
              <li class="rounded-full border border-sea-200 px-3 py-1 text-xs font-semibold text-sea-700">{pill}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid gap-8 md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">Why sites lose enquiries</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">A site that is hard to use on a phone loses the customer.</h2>
        <p class="mt-3 text-ink-700">We fix these first. We cannot promise a number of enquiries, and your stats show what changes.</p>
        <figure class="mt-8 flex flex-col items-center md:items-start">
          <div data-animate class="relative w-56 overflow-hidden rounded-[2.2rem] border-[10px] border-ink-900 bg-ink-900 shadow-xl" style="aspect-ratio: 9 / 18">
            <img
              src="/images/work/eagles-roost/phone-home.webp"
              alt="Eagle's Roost home page on a phone: logo, a WhatsApp Book button, the river view, and a Check Availability button further down"
              width="500"
              height="2000"
              loading="lazy"
              class="phone-screen block w-full"
            />
          </div>
          <figcaption class="mt-3 text-sm text-ink-500">Eagle’s Roost on a phone, a live client.</figcaption>
        </figure>
      </div>
      <ul class="md:col-span-3">
        {
          [
            ["broken", "It breaks on a phone.", "Many visitors arrive on a phone. If the text is tiny or the menu will not open, they leave."],
            ["nobutton", "There is no obvious button.", "A WhatsApp or call button on every page is the quickest way for a customer to ask."],
            ["price", "The price is unclear.", "A customer who cannot tell what something costs may not ask. We show the price and tell you honestly which tier fits."],
          ].map(([icon, title, text]) => (
            <li class="flex gap-4 border-t border-sea-100 py-4 first:border-t-0 first:pt-0">
              <LineIcon name={icon as "broken" | "nobutton" | "price"} class="h-10 w-10 shrink-0 text-sea-900" />
              <div>
                <h3 class="font-display text-lg font-semibold text-ink-900">{title}</h3>
                <p class="mt-1 text-ink-700">{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">Live</h2>
      <a href="/work/" class="text-sm font-semibold text-sea-700 hover:text-sea-500">All work →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        samples.map((sample) => (
          <article class="overflow-hidden rounded-2xl border border-sea-100 bg-white p-6 shadow-sm">
            <img src={sample.snip} alt={`Screenshot of ${sample.title}`} width="1200" height="750" class="-mx-6 -mt-6 mb-5 aspect-[16/8] w-[calc(100%+3rem)] max-w-none object-cover object-top" loading="lazy" />
            <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{sample.kind}</p>
            <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{sample.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">{sample.blurb}</p>
            {sample.url ? (
              <a
                href={sample.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex text-sm font-semibold text-accent-600 hover:text-accent-700"
              >
                Visit live site →
              </a>
            ) : null}
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink-900">In process</h2>
      <a href="/work/#in-process" class="text-sm font-semibold text-sea-700 hover:text-sea-500">
        Mockups and photos →
      </a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        inProcess.map((job) => {
          const previewUrl = "previewUrl" in job ? job.previewUrl : undefined;
          const href = previewUrl ?? "/work/#in-process";
          const external = Boolean(previewUrl);
          return (
            <a
              href={href}
              class="group overflow-hidden rounded-2xl border border-sea-100 bg-white shadow-sm"
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              <div class="aspect-[16/10] overflow-hidden bg-sea-100">
                <img
                  src={job.snip}
                  alt={`Screenshot of ${job.title}`}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">{job.kind}</p>
                <h3 class="mt-1 font-display text-lg font-semibold text-ink-900">{job.title}</h3>
                <p class="mt-2 text-xs font-medium text-sea-700">{job.package}</p>
                {
                  previewUrl ? (
                    <p class="mt-3 text-sm font-semibold text-sea-700 group-hover:text-sea-500">
                      Open work-in-progress preview →
                    </p>
                  ) : null
                }
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="border-y border-sea-100 bg-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="grid gap-4 md:grid-cols-2 md:items-end">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">How it works</p>
          <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">From first chat to live site.</h2>
        </div>
        <p class="text-ink-700">Three steps, and you pay a fixed price.</p>
      </div>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {
          homeSteps.map((step, index) => (
            <li class="rounded-2xl border border-sea-200 bg-white p-5">
              <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Step {index + 1}</p>
                <LineIcon name={stepIcons[index]} class="h-10 w-10 text-sea-900" />
              </div>
              <h3 class="mt-2 font-display text-lg font-semibold text-ink-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-700">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a href="/method/" class="mt-6 inline-flex text-sm font-semibold text-sea-700 hover:text-accent-600">See the full method →</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid items-center gap-6 rounded-3xl bg-sea-900 p-6 text-cream-50 sm:p-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-sea-200">{phoneApp.status}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold">{phoneApp.name}</h2>
        <p class="mt-3 text-sea-100">{phoneApp.lede}</p>
      </div>
      <div class="md:text-right">
        <a href="/phone-app/" class="inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-sea-900">See the phone app →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid items-center gap-10 rounded-3xl border border-sea-100 bg-white p-6 shadow-sm sm:p-8 md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">Admin dashboard</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">See whether your website is working.</h2>
        <p class="mt-3 text-ink-700">
          One private page with your visits, the Google searches that find you, what is done and what is still to do.
          Included on Business and Custom. On Starter and Brochure it is <span class="whitespace-nowrap">{zar(site.adminAddonPriceZar)}</span> once.
        </p>
        <a href="/included/#dashboard" class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:text-accent-600">See the dashboard →</a>
      </div>
      <div data-animate class="dash-stack relative md:col-span-3 md:pb-[18%]">
        <img
          src="/images/dashboard/project-completion.webp"
          alt="Project completion board on the Eagle's Roost dashboard: four lanes of steps, each marked Done, To do or Unknown"
          width="1180"
          height="428"
          loading="lazy"
          class="dash-a relative w-full rounded-2xl border border-sea-100 shadow-lg md:w-[92%]"
        />
        <img
          src="/images/dashboard/reminders-links.webp"
          alt="Task reminders with dates and owners, and links to the client's own accounts, on the Eagle's Roost dashboard"
          width="1180"
          height="400"
          loading="lazy"
          class="dash-b relative mt-4 w-full rounded-2xl border border-sea-100 bg-white shadow-xl md:absolute md:right-0 md:bottom-0 md:mt-0 md:w-[78%]"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid items-center gap-6 rounded-3xl border border-sea-100 bg-cream-100 p-6 sm:p-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-sea-600">Extra</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">{logoService.name}</h2>
        <p class="mt-3 text-ink-700">{logoService.lede} {logoService.pricing}</p>
      </div>
      <div class="md:text-right">
        <a href="/offer/#logo" class="inline-flex rounded-full bg-sea-900 px-5 py-2.5 text-sm font-semibold text-white">See the offer →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-8 md:grid-cols-5">
      <div class="md:col-span-2 md:sticky md:top-6 md:self-start">
        <p class="text-sm font-semibold uppercase tracking-wide text-sea-600">Common questions</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900">What people usually ask.</h2>
        <a href="/offer/" class="mt-4 inline-flex text-sm font-semibold text-sea-700 hover:text-accent-600">All questions and the full offer →</a>
      </div>
      <div class="md:col-span-3">
        {
          homeFaq.map(({ q, a }, index) => (
            <details class="group border-t border-sea-100 py-4 last:border-b" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
                {q}
                <span aria-hidden="true" class="text-accent-600 group-open:hidden">+</span>
                <span aria-hidden="true" class="hidden text-accent-600 group-open:inline">-</span>
              </summary>
              <p class="mt-2 text-sm leading-relaxed text-ink-700">{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-sea-100 bg-cream-100">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-3">
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">Fixed price, no surprises</h2>
        <p class="mt-2 text-sm text-ink-700">
          Two revision rounds, deposit up front. Domain at actual cost.
          From {zar(site.startingPriceZar)}, Brochure {zar(site.brochurePriceZar)}, bigger work quoted.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">You own it</h2>
        <p class="mt-2 text-sm text-ink-700">
          Keep your domain if you have one. Keep or downscale hosting. Source files handed over.
        </p>
      </div>
      <div>
        <h2 class="font-display text-lg font-semibold text-ink-900">One person to talk to</h2>
        <p class="mt-2 text-sm text-ink-700">
          Same method we used for Three Birds in Anerley. Sharon answers on the South Coast, Emilio
          everywhere else.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid items-center gap-8 rounded-3xl bg-sea-900 p-6 text-cream-50 sm:p-8 md:grid-cols-5">
      <div class="flex items-center gap-5 md:col-span-2">
        <img
          src="/images/emilio-martin.webp"
          alt="Emilio Martin"
          width="384"
          height="480"
          loading="lazy"
          class="h-36 w-28 shrink-0 rounded-2xl object-cover sm:h-44 sm:w-36"
        />
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-sea-200">The person you work with</p>
          <p class="mt-1 font-display text-xl font-semibold">Emilio Martin</p>
          <p class="text-sm text-sea-100">Founder, FactSmith Sites</p>
        </div>
      </div>
      <div class="md:col-span-3">
        <h2 class="font-display text-2xl font-semibold">Founder-led, with no sales team in between.</h2>
        <p class="mt-3 text-sea-100">
          Emilio Martin has spent 25 years building data systems for banks, retailers, manufacturers, mines and schools. You work
          with Emilio directly, not with a junior team. Sharon Cooper looks after South Coast enquiries in person.
        </p>
        <a href="https://www.factsmith.co.za/about/" class="mt-4 inline-flex text-sm font-semibold text-white underline decoration-accent-300 underline-offset-4" target="_blank" rel="noopener">More about Emilio →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-display text-2xl font-semibold text-ink-900">Ready for a straight conversation?</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-700">
      Book a short consult. We’ll tell you honestly what your site needs and which tier fits.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <BookButton />
      <WhatsAppButton variant="outline" />
    </div>
    <p class="mt-4 text-sm text-ink-500">
      South Coast: Sharon. Elsewhere: <a class="underline" href={`${site.emilio.whatsappLink}?text=${encodeURIComponent(site.emilio.whatsappMessage)}`}>message Emilio</a>.
    </p>
  </section>
</BaseLayout>

<style>
  /* Motion, only when the visitor allows it and only once, when the block comes into view (data-animate gets .is-in).
     At rest everything is in its final place, so the page is complete without the motion. */
  @media (prefers-reduced-motion: no-preference) {
    /* Hero landing: each piece rises in turn on load, then the first button rings once. */
    .hero-rise { animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) both; }
    .hero-buttons > :first-child { animation: hero-ring 1.4s ease-out 1.4s 1 both; }
    .is-in .phone-screen { animation: phone-scroll 9s ease-in-out 0.4s 1 both; }
    .dash-stack.is-in .dash-a { animation: deal-a 0.8s ease-out both; }
    .dash-stack.is-in .dash-b { animation: deal-b 0.9s ease-out 0.25s both; }
  }
  @media (min-width: 768px) {
    .dash-b { transform: rotate(-1.5deg); }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-ring {
    0% { box-shadow: 0 0 0 0 rgb(176 42 82 / 0.5); }
    100% { box-shadow: 0 0 0 16px rgb(176 42 82 / 0); }
  }
  @keyframes phone-scroll {
    0%, 12% { transform: translateY(0); }
    50%, 62% { transform: translateY(-48%); }
    100% { transform: translateY(0); }
  }
  @keyframes deal-a {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes deal-b {
    from { opacity: 0; transform: translate(48px, 32px) rotate(3deg); }
    to { opacity: 1; transform: rotate(-1.5deg); }
  }
</style>

<script>
  // Adds .is-in to each [data-animate] block once it is in view. Without IntersectionObserver nothing moves.
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("is-in");
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.4 });
    document.querySelectorAll("[data-animate]").forEach((el) => observer.observe(el));
  }
</script>
