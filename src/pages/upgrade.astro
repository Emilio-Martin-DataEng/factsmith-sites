---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { upgrade, freeCall, libraryPages, site } from "../site.config";

const message = "Hi Emilio, I would like to add a page to my current website. Can we book the free 10-minute call?";
---

<BaseLayout
  title="Add a page to your current website"
  description={`Weather and tides, or another page, added to the website you already have. ${upgrade.priceText} We hand it to whoever looks after your site.`}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Keep your website, add a page</p>
    <h1 class="mt-1 font-display text-4xl font-semibold text-ink-900">{upgrade.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">{upgrade.lede}</p>
    <p class="mt-4 max-w-2xl text-lg font-semibold text-ink-900">{upgrade.priceText}</p>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">How it works</h2>
    <ol class="mt-4 max-w-2xl list-decimal space-y-2 pl-5 text-ink-700">
      {upgrade.steps.map((s) => <li>{s}</li>)}
    </ol>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">Pages we can add</h2>
    <ul class="mt-4 max-w-2xl list-disc space-y-2 pl-5 text-ink-700">
      {libraryPages.filter((p) => p.kind !== "app").map((p) => <li><span class="font-semibold">{p.title}.</span> {p.text}</li>)}
    </ul>

    <h2 class="mt-12 font-display text-xl font-semibold text-ink-900">What to know first</h2>
    <ul class="mt-4 max-w-2xl list-disc space-y-2 pl-5 text-ink-700">
      {upgrade.limits.map((l) => <li>{l}</li>)}
    </ul>

    <div class="mt-12 max-w-2xl rounded-2xl border border-sea-200 bg-sea-50 p-6">
      <h2 class="font-display text-xl font-semibold text-ink-900">{freeCall.name}</h2>
      <p class="mt-2 text-ink-700">{freeCall.lede}</p>
      <p class="mt-3 text-sm text-ink-500">{freeCall.limitText}</p>
      <p class="mt-3 text-sm"><a href="/referral/#free-call" class="font-semibold text-accent-600 hover:text-accent-700">What the free check covers →</a></p>
    </div>

    <div class="mt-10">
      <WhatsAppButton label="Ask about a page" href={site.emilio.whatsappLink} message={message} />
    </div>
  </section>
</BaseLayout>
